<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- UVC 摄像头预览宿主（TvCameraFragment 在此） -->
    <FrameLayout
        android:id="@+id/camera_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 识别框叠加层（不拦截按键） -->
    <com.example.arcfaceandroid.FaceOverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- 顶部状态条 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#660B0F14">

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#B0BEC5"
            android:text="@string/tv_status_init" />

        <TextView
            android:id="@+id/tv_addr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="24dp"
            android:textSize="16sp"
            android:textColor="#78909C"
            android:text="" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#00E5D4"
            android:text="" />
    </LinearLayout>

    <!-- 底部操作提示 -->
    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:padding="14dp"
        android:background="#660B0F14"
        android:textSize="15sp"
        android:textColor="#90A4AE"
        android:text="@string/tv_hint" />

    <!-- 双路融合「房间状态」面板（右上角，TV 路 + 米家全景路按名融合） -->
    <com.example.arcfaceandroid.RoomStatusView
        android:id="@+id/room_status"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="76dp"
        android:layout_marginEnd="16dp" />

    <!-- 设置面板（默认隐藏，菜单键 / 右方向键唤起） -->
    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="#EE0B0F14"
        android:padding="24dp"
        android:visibility="gone"
        android:focusable="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tv_settings_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_zoom_mode"
            style="@style/TvCardButton"
            android:text="@string/tv_zoom_mode" />

        <Button
            android:id="@+id/btn_snapshot"
            style="@style/TvCardButton"
            android:text="@string/tv_snapshot" />

        <Button
            android:id="@+id/btn_register"
            style="@style/TvCardButton"
            android:text="@string/tv_register" />

        <Button
            android:id="@+id/btn_manage"
            style="@style/TvCardButton"
            android:text="@string/tv_manage" />

        <Button
            android:id="@+id/btn_service"
            style="@style/TvCardButton"
            android:text="@string/tv_service_toggle" />

        <Button
            android:id="@+id/btn_close_panel"
            style="@style/TvCardButton"
            android:text="@string/tv_close_panel" />
    </LinearLayout>

    <!-- 人脸库 / 录入 全屏宿主 -->
    <FrameLayout
        android:id="@+id/fragment_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone" />

</FrameLayout>
