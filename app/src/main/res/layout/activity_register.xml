<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 摄像头预览 -->
    <TextureView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 人脸框叠加层 -->
    <com.example.arcfaceandroid.RegisterOverlayView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/top_gradient">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="人脸注册引导"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="请站在椭圆区域内，正对摄像头"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

        <!-- 多姿态进度指示器 -->
        <LinearLayout
            android:id="@+id/pose_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/pose_1"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="正"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="#455A64"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/pose_2"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="左"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="#455A64"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/pose_3"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="右"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="#455A64"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/pose_4"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="仰"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="#455A64"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/pose_5"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="低"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:background="#455A64" />
        </LinearLayout>
    </LinearLayout>

    <!-- 模式选择面板（初始显示） -->
    <LinearLayout
        android:id="@+id/mode_select_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:padding="48dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择注册方式"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_new_user"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:text="新建用户"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:background="#1A237E"
            android:padding="16dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_append_user"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:text="追加到已有用户"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:background="#00695C"
            android:padding="16dp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_mode_cancel"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="返回"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="#455A64"
            android:padding="12dp" />
    </LinearLayout>

    <!-- 已有用户列表面板（追加模式时显示） -->
    <LinearLayout
        android:id="@+id/user_list_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:padding="48dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择要追加的用户"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <ScrollView
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:maxHeight="400dp">

            <LinearLayout
                android:id="@+id/user_list_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/btn_user_list_back"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="返回"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:background="#455A64"
            android:padding="12dp"
            android:layout_marginTop="24dp" />
    </LinearLayout>

    <!-- 底部信息面板 -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@drawable/bottom_gradient">

        <!-- 姿态引导文字（多姿态模式时显示当前动作） -->
        <TextView
            android:id="@+id/tv_pose_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#FFD54F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"
            android:visibility="gone" />

        <!-- 状态提示 -->
        <TextView
            android:id="@+id/tv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="正在检测人脸..."
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- 质量指标 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="人脸: --"
                android:textColor="#90A4AE"
                android:textSize="13sp"
                android:layout_marginEnd="20dp" />

            <TextView
                android:id="@+id/tv_angle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="角度: --"
                android:textColor="#90A4AE"
                android:textSize="13sp"
                android:layout_marginEnd="20dp" />

            <TextView
                android:id="@+id/tv_brightness"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="亮度: --"
                android:textColor="#90A4AE"
                android:textSize="13sp"
                android:layout_marginEnd="20dp" />

            <TextView
                android:id="@+id/tv_persons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="人数: --"
                android:textColor="#90A4AE"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 姓名输入 -->
        <LinearLayout
            android:id="@+id/name_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="姓名:"
                android:textColor="#B0BEC5"
                android:textSize="14sp"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/et_name"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:hint="请输入姓名"
                android:textColor="#FFFFFF"
                android:textColorHint="#607D8B"
                android:textSize="14sp"
                android:background="#1A237E"
                android:padding="10dp"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:inputType="text" />
        </LinearLayout>

        <!-- 注册模式选择（快速/完整） -->
        <LinearLayout
            android:id="@+id/register_mode_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btn_quick_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="快速(1张正脸)"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:background="#1A237E"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="12dp" />

            <Button
                android:id="@+id/btn_full_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="完整(5张多姿态)"
                android:textColor="#B0BEC5"
                android:textSize="13sp"
                android:background="#455A64"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <!-- 按钮区 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="取消"
                android:textColor="#FFFFFF"
                android:background="#455A64"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btn_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始注册"
                android:textColor="#FFFFFF"
                android:background="#1A237E"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 倒计时遮罩 -->
    <TextView
        android:id="@+id/tv_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text=""
        android:textColor="#4CAF50"
        android:textSize="120sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 注册成功遮罩 -->
    <LinearLayout
        android:id="@+id/success_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#CC000000"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textColor="#4CAF50"
            android:textSize="80sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="注册成功！"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_success_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#B0BEC5"
            android:textSize="16sp"
            android:layout_marginBottom="32dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_done"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="完成"
                android:textColor="#FFFFFF"
                android:background="#4CAF50"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginEnd="16dp" />

            <Button
                android:id="@+id/btn_reregister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重新注册"
                android:textColor="#FFFFFF"
                android:background="#455A64"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
