<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ===== 设备能力声明（TV 适配）===== -->
    <!-- 声明为电视应用，否则不会出现在小米电视桌面上 -->
    <uses-feature android:name="android.hardware.type.television" android:required="true" />
    <!-- 必须支持 USB Host 才能识别 UVC 摄像头（Camera2 方案不直接用 USB Host，但保留声明无害） -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- TV 没有触摸屏，声明非必需，避免被过滤 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- UVC 摄像头不走系统 camera，故把系统 camera 设为非必需 -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Camera2 打开系统摄像头所需 -->
    <uses-permission android:name="android.permission.CAMERA" />

    <queries>
        <intent>
            <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.ArcFace"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <!-- 常亮大屏主界面（leanback + 普通 launcher 双入口，方便 sideload 调试） -->
        <activity
            android:name=".TvMainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Camera2 方案不需要 USB 授权弹窗，禁用 USB_DEVICE_ATTACHED 自动拉起，
                 避免插摄像头时弹出"勾选接入"的 USB 权限框（UVC 路径残留）。
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
            -->
        </activity>

        <!-- 人脸识别 + HTTP 服务前台服务（dataSync 用于 LAN 接口；mediaPlayback 用于静音 AudioTrack 保活；camera 用于后台持续识别） -->
        <service
            android:name=".FaceServerService"
            android:exported="false"
            android:foregroundServiceType="dataSync|mediaPlayback|camera" />

        <!-- 开机自启 -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- 看门狗（AlarmManager 层，进程被杀后更快拉起，比 WorkManager 15 分钟更频） -->
        <receiver
            android:name=".AlarmWatchdogReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.arcfaceandroid.ALARM_WATCHDOG" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
